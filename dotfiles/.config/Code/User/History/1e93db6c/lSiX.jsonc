{
  "layer": "top",
  "position": "top",
  "exclusive": false,

  "margin-top": 7,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 0,

  "modules-left": [
    "custom/media"
  ],

  "modules-center": [
    "hyprland/workspaces",
    "clock"
  ],

  "modules-right": [
    "pulseaudio",
    "network",
    "bluetooth"
  ],

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "all-outputs": true,
    "show-special": false,
    "persistent-workspaces": {
        "*": [1, 2, 3, 4, 5, 6]
    }
  },

  "clock": {
    "format": " {:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": " muted",
    "on-click": "pavucontrol"
  },

  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": "󰈀 wired",
    "format-disconnected": "⚠ offline"
  },

  "bluetooth": {
    "format": "",
    "on-click": "blueman-manager"
  },

  "custom/media": {
    "format": " {}",
    "return-type": "json",
    "exec": "playerctl -f '{\"text\":\" {{artist}} – {{title}}\"}' metadata 2>/dev/null || echo '{\"text\":\"Spotify\"}'",
    "interval": 2,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "max-length": 40
  }
}
