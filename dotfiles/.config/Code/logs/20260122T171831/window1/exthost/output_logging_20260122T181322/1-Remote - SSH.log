VSCH_LOGFILE="$VSCODE_AGENT_FOLDER/.$COMMIT_ID.log"
VSCH_PIDFILE="$VSCODE_AGENT_FOLDER/.$COMMIT_ID.pid"
VSCH_TOKENFILE="$VSCODE_AGENT_FOLDER/.$COMMIT_ID.token"

fail_with_exitcode() {
	echo "9e6ec3f8384e: start"
	echo "exitCode==$1=="
	echo_common_results
	echo "9e6ec3f8384e: end"
	exit 0
