if [[ $RUNNING == 0 ]]; then
	start_server
elif [[ ! -f "$VSCH_LOGFILE" ]]; then
	echo "WARNING: VS Code Server is running but its logfile is missing. Don't delete the VS Code Server manually, run the command 'Uninstall VS Code Server'."
	start_server
