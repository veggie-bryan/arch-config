			rm "$VSCODE_AGENT_FOLDER/.$COMMIT_TO_DELETE.log"
			if [[ -f "$VSCODE_AGENT_FOLDER/.$COMMIT_TO_DELETE.pid" ]]; then
				rm "$VSCODE_AGENT_FOLDER/.$COMMIT_TO_DELETE.pid"
