write_connection_token() {
	rm "$VSCH_TOKENFILE"
	CONNECTION_TOKEN="cd6548a7-9de1-4472-a5b7-461fd3378efd"
	touch "$VSCH_TOKENFILE"
	chmod 0700 "$VSCH_TOKENFILE"
