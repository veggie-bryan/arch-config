				fail_with_exitcode 199
			fi

			echo "Found flag and server on host"
			rm "$VSCH_DIR/vscode-server.tar.gz.done"
			break
		else
			echo -n ' '
			sleep 3
		fi
	done
}

do_client_download_or_fail() {
	if [[ $DID_LOCAL_DOWNLOAD == "1" ]]; then
