echo DISPLAY==$DISPLAY==
echo "webUiAccessToken==$WEBUITOKEN=="
echo_common_results
echo "connectionToken==$CONNECTION_TOKEN=="
echo "7a6d4a3da103: end"

unlock $MAIN_LOCKFD $COMMIT_ID

