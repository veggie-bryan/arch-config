		if (( $PREREQ_EXIT_CODE == 99 )); then
			fail_with_exitcode 207
		elif (( $PREREQ_EXIT_CODE == 100 )); then
			if [[ $FORCE_CLIENT_DOWNLOAD != "1" ]]; then
