	if [[ $MANUAL_BOOTSTRAP == "1" ]]; then
		do_manual_bootstrap
	else
		if [[ $FORCE_CLIENT_DOWNLOAD == "1" ]]; then
			do_client_download
		else
			do_host_download
		fi
