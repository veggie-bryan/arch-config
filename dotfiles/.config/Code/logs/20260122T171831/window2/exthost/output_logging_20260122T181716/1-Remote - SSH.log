	get_lockfile() {
		lockfiles_in_tmp=0
		lockfile_name=vscode-remote-lock.$USER.$1
		if [[ $lockfiles_in_tmp == "1" ]]; then
			echo "$VSC_TMP/$lockfile_name"
		else
			echo "$VSCODE_AGENT_FOLDER/bin/$1/$lockfile_name"
