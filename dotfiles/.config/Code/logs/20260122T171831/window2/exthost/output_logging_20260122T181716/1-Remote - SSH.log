	SERVER_PID=`cat "$VSCH_PIDFILE"`
	echo "Looking for server with pid: $SERVER_PID"
	ALL_PROCS=`ps ax | grep "^\s*$SERVER_PID\s"`
else
	ALL_PROCS=`ps ax`
fi

RUNNING="`echo $ALL_PROCS | grep "$VSCH_SERVER_SCRIPT" | grep -v grep | wc -l | tr -d '[:space:]'`"
if [[ $RUNNING == 0 ]]; then
