if [[ -z $OSRELEASEID ]]
then
	OSRELEASEID=`cat /usr/lib/os-release 2>/dev/null | grep -a -E '^ID=' | sed 's/^[Ii][Dd]=//g' | sed 's/"//g'`
	if [[ -z $OSRELEASEID ]]
	then
		OSRELEASEID=`uname -s`
	fi
fi


#
# Get host platform/architecture
#
UNAME=$(uname -s)
case $UNAME in
