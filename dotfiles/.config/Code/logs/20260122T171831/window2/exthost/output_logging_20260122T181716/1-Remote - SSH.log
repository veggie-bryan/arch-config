#
write_connection_token() {
	rm "$VSCH_TOKENFILE"
	CONNECTION_TOKEN="bbaa7259-c3de-4b71-b5ce-31db804eef0b"
	touch "$VSCH_TOKENFILE"
	chmod 0700 "$VSCH_TOKENFILE"
	echo $CONNECTION_TOKEN > "$VSCH_TOKENFILE"
