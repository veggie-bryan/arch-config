WEBUITOKEN=`cat "$VSCH_LOGFILE" | grep -a -E 'Web UI available at' | grep -o -E 'tkn=[0-9a-f-]+' | grep -o -E '[0-9a-f-]+'`
if [[ -z $LISTENING_ON ]]
then
	echo "Server did not start successfully. Full server log at $VSCH_LOGFILE >>>"
	cat "$VSCH_LOGFILE"
	echo "<<< End of server log"
