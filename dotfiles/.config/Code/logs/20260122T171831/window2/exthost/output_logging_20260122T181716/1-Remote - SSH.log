	setup_locking $COMMIT_TO_DELETE $CLEANUP_LOCKFD
	exlock_now $CLEANUP_LOCKFD $COMMIT_TO_DELETE
	if (( $? == 0 )); then
		setup_lock_cleanup $COMMIT_TO_DELETE $CLEANUP_LOCKFD
