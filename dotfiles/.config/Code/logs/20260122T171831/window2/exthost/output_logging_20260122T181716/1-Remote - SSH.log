	do
		LISTENING_ON=`cat "$VSCH_LOGFILE" | grep -a -E 'Extension host agent listening on .+' | grep -v grep | sed 's/Extension host agent listening on //'`
		if [[ $LISTENING_ON != '' ]]
		then
			break
		fi

		echo "Waiting for server log..."
		sleep .03
	done

	SERVER_START_TIME=$(elapsed $start)
}

