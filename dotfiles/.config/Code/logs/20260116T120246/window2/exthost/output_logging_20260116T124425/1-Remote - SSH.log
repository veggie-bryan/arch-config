	then
		echo "Checking server status on port $LISTENING_ON with wget"
		WGET_OUT=$(wget --no-config --no-proxy -nv -O - http://127.0.0.1:$LISTENING_ON/delay-shutdown 2>&1)
		if [[ $? != 0 ]]; then
