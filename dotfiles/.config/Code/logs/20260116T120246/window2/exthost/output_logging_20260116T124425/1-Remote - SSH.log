VSC_TMP="${XDG_RUNTIME_DIR:-`echo /tmp`}"
COMMIT_ID="bf9252a2fb45be6893dd8870c0bf37e2e1766d61"
SERVER_APP_NAME="code-server"
EXTENSIONS=""
