then
	echo "Installing to $VSCH_DIR..."
	STASHED_WORKING_DIR="`pwd`"
	cd "$VSCH_DIR"

	if [[ $MANUAL_BOOTSTRAP == "1" ]]; then
		do_manual_bootstrap
	else
		if [[ $FORCE_CLIENT_DOWNLOAD == "1" ]]; then
			do_client_download
		else
			do_host_download
		fi
	fi

	do_install

