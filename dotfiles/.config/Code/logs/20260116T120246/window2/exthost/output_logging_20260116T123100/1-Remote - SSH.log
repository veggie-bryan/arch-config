			if [[ ($? != 0) || ($CURL_OUTPUT != "OK 200") ]]; then
				echo $CURL_OUTPUT
				fail_with_exitcode 197
			fi
		else
			echo "Neither wget nor curl is installed"
			fail_with_exitcode 194
		fi
	fi
