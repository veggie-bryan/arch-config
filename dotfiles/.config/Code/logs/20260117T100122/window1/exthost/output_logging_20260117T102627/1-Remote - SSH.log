	echo "Waiting for client to transfer server archive..."
	echo "Waiting for $VSCH_DIR/vscode-server.tar.gz.done and vscode-server.tar.gz to exist"

	while true; do
		if [[ -f "$VSCH_DIR/vscode-server.tar.gz.done" ]]; then
