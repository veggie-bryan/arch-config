	setup_lock_cleanup()  {
		if [[ $use_flock == "0" ]]; then
			trap "_no_more_locking $1" EXIT
		fi
	}

	# obtain an exclusive lock immediately or fail
	exlock_now() {
		if [[ $use_flock == "1" ]]; then
