echo "ffc2698f20d7: running"

#
# Setup
#
VSC_TMP="${XDG_RUNTIME_DIR:-`echo /tmp`}"
COMMIT_ID="bf9252a2fb45be6893dd8870c0bf37e2e1766d61"
SERVER_APP_NAME="code-server"
EXTENSIONS=""
TELEMETRY="--telemetry-level all"
VSCODE_AGENT_FOLDER=$HOME/.vscode-server
ALLOW_CLIENT_DOWNLOAD="1"
FORCE_CLIENT_DOWNLOAD="0"
MANUAL_BOOTSTRAP="0"
now=`date +%s`
VERBOSE="0"



PORT_FLAG=--port=0

SERVER_LISTEN_FLAG=
UNPACK_RESULT=
DID_LOCAL_DOWNLOAD=0
DOWNLOAD_TIME=
INSTALL_TIME=
EXT_INSTALL_TIME=
