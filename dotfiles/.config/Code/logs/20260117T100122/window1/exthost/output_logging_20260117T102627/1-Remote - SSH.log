do_client_download_or_fail() {
	if [[ $DID_LOCAL_DOWNLOAD == "1" ]]; then
		echo "Already attempted local download, failing"
		fail_with_exitcode $1
	elif [[ $ALLOW_CLIENT_DOWNLOAD == "1" ]]; then
