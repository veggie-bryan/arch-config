write_connection_token() {
	rm "$VSCH_TOKENFILE"
	CONNECTION_TOKEN="eff2150a-db15-4304-8ecc-4dd4ed96f580"
	touch "$VSCH_TOKENFILE"
	chmod 0700 "$VSCH_TOKENFILE"
