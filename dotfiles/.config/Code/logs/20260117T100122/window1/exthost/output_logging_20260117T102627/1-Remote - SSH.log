			if [[ $FORCE_CLIENT_DOWNLOAD != "1" ]]; then
				PLATFORM_DOWNLOAD_PATH=server-linux-legacy-$VSCODE_ARCH
				rm -rf "$VSCH_DIR"
				do_create_install_dir
				cd "$VSCH_DIR"
				do_host_download
				do_install
			fi
		fi
	fi
	cd "$STASHED_WORKING_DIR"
else
	echo "Found existing installation at $VSCH_DIR..."
fi


