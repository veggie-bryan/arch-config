			_lock xn $2 && rm -f $(get_lockfile $1)
		else
			lockfile_name=$(get_lockfile $1)
			rm -f "$lockfile_name"
			rm -f "$lockfile_name.target"
		fi
	}

	# PUBLIC - all take lock FD

	setup_locking() {
		if [[ $use_flock == "1" ]]; then
			eval "exec $2>\"$(get_lockfile $1)\"";
			trap "_no_more_locking $1 $2" EXIT
		fi
