	echo "installTime==$INSTALL_TIME=="
	echo "extInstallTime==$EXT_INSTALL_TIME=="
	echo "serverStartTime==$SERVER_START_TIME=="
}


millis() {
	if [[ $PLATFORM == linux ]]; then
		echo $(($(date +%s%N)/1000000))
	else
		# Can't get actual millis on mac
		echo $(($(date +%s)*1000))
	fi
}

elapsed() {
	echo $(($(millis) - $1))
}

do_create_install_dir() {
	if [[ ! -d "$VSCH_DIR" ]]; then
