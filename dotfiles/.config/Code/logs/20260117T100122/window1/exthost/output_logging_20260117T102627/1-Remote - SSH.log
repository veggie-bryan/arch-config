	echo "serverStartTime==$SERVER_START_TIME=="
}


millis() {
	if [[ $PLATFORM == linux ]]; then
		echo $(($(date +%s%N)/1000000))
	else
		# Can't get actual millis on mac
		echo $(($(date +%s)*1000))
	fi
}

elapsed() {
	echo $(($(millis) - $1))
}

do_create_install_dir() {
	if [[ ! -d "$VSCH_DIR" ]]; then
		mkdir -p "$VSCH_DIR"

		if (( $? > 0 ))
		then
			echo "Creating the server install dir failed..."
			fail_with_exitcode 202
		fi
	fi
}
do_create_install_dir

printenv_indent() {
	if [[ $VERBOSE == "1" ]]; then
		echo "printenv:"
		printenv | sed 's/^/    /'
	fi
