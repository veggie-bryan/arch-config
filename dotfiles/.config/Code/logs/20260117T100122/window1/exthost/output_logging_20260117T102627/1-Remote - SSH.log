				CURL_OUTPUT=$(curl --disable --noproxy 127.0.0.1 -s --unix-socket $LISTENING_ON http://127.0.0.1/delay-shutdown -w " %{http_code}")
			fi

			if [[ ($? != 0) || ($CURL_OUTPUT != "OK 200") ]]; then
				echo $CURL_OUTPUT
				fail_with_exitcode 197
			fi
