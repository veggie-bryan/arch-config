	# PUBLIC - all take lock FD

	setup_locking() {
		if [[ $use_flock == "1" ]]; then
			eval "exec $2>\"$(get_lockfile $1)\"";
			trap "_no_more_locking $1 $2" EXIT
		fi
	}

	setup_lock_cleanup()  {
		if [[ $use_flock == "0" ]]; then
			trap "_no_more_locking $1" EXIT
		fi
	}

	# obtain an exclusive lock immediately or fail
	exlock_now() {
		if [[ $use_flock == "1" ]]; then
